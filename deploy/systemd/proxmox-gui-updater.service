# /etc/systemd/system/proxmox-gui-updater.service   (root:root 0644)
# One update per activation. Runs as root but confined: it can write only the paths it manages.
# `apply` reads and deletes the request file first, then downloads, verifies the signature and
# hash, validates the tarball and installs into a NEW release directory (never the active one).

[Unit]
Description=Proxmox GUI updater (signed releases only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proxmox-gui-updater apply
TimeoutStartSec=1800
RuntimeDirectory=proxmox-gui-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/proxmox-gui /var/lib/proxmox-gui /var/lib/proxmox-gui-updater /etc/proxmox-gui /etc/systemd/system /usr/local/sbin
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native
UMask=0022
