# /etc/systemd/system/proxmox-gui-worker.service   (root:root 0644, installed by bootstrap.sh)
# arq worker: UPID polling, orphan reaper, job execution. Same privilege model as the API.

[Unit]
Description=Proxmox GUI Worker (arq)
After=network-online.target proxmox-gui-api.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=proxmox-gui
Group=proxmox-gui
SupplementaryGroups=redis
WorkingDirectory=/opt/proxmox-gui/current/backend
Environment=PROXMOX_GUI_MASTER_KEY_PATH=/etc/proxmox-gui/master.key
Environment=PROXMOX_GUI_DATABASE_URL=sqlite+aiosqlite:////var/lib/proxmox-gui/app.db
Environment=PROXMOX_GUI_JWT_SECRET_FILE=/etc/proxmox-gui/jwt.secret
Environment=PROXMOX_GUI_PAT_PEPPER_FILE=/etc/proxmox-gui/pat.pepper
Environment=PROXMOX_GUI_REDIS_SOCKET=/run/redis/redis-server.sock
EnvironmentFile=-/etc/proxmox-gui/gui.env
ExecStart=/opt/proxmox-gui/current/.venv/bin/arq app.jobs.worker.WorkerSettings
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# --- hardening (F-12) — identical to the API unit ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proxmox-gui
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProcSubset=pid
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
