{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py",
            "args": []
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./docs/spec/**)",
      "Edit(./docs/plan.md)",
      "Edit(./gates.toml)",
      "Edit(./Makefile)",
      "Edit(./tests/acceptance/**)",
      "Edit(./orchestrator/**)",
      "Edit(./.claude/**)",
      "Edit(./.opencode/**)",
      "Edit(./.github/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)"
    ]
  }
}
